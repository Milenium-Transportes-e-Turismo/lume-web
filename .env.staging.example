# =============================================================================
# LUME TENANT WEB — STAGING
# Copie para .env.staging somente na VPS. Não versione o arquivo real.
# =============================================================================

# API da mesma instalação de staging. Nunca aponte homologação para produção.
LUME_TENANT_API_URL=https://staging.lumestack.app.br/api/v1
LUME_TENANT_API_TIMEOUT_MS=5000
LUME_TENANT_API_DOCUMENT_REVIEW_TIMEOUT_MS=300000
LUME_TENANT_API_WHATSAPP_IMPORT_TIMEOUT_MS=600000

# Segredo exclusivo de staging, com no mínimo 32 bytes. Preserve o valor entre
# deploys para não invalidar todas as sessões existentes.
SESSION_SECRET=replace-me

# Travas obrigatórias. A readiness responde 503 se qualquer valor divergir.
AUTH_SIMULATION_ENABLED=false
LUME_TENANT_WHATSAPP_DATA_SOURCE=api

# Valores públicos incorporados no build. Passe os mesmos valores como
# --build-arg ao construir a imagem Docker.
NEXT_PUBLIC_TENANT_NAME=Empresa
NEXT_PUBLIC_TENANT_PRODUCT_NAME=Lume
