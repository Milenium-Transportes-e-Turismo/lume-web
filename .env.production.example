# =============================================================================
# LUME TENANT WEB — PRODUÇÃO
# Modelo para o cofre de configuração da plataforma. Não copie segredos reais
# para o repositório, para a imagem Docker ou para logs.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DOMÍNIO/ENDPOINT DA TENANT API [OBRIGATÓRIO]
# Informe a URL HTTPS da Tenant API desta instalação, incluindo /api/v1.
# O timeout é opcional (padrão: 5000 ms; faixa aceita: 100 a 30000 ms).
# -----------------------------------------------------------------------------
LUME_TENANT_API_URL=https://tenant-api.example.com/api/v1
LUME_TENANT_API_TIMEOUT_MS=5000
LUME_TENANT_API_DOCUMENT_REVIEW_TIMEOUT_MS=300000
LUME_TENANT_API_WHATSAPP_IMPORT_TIMEOUT_MS=600000

# -----------------------------------------------------------------------------
# 2. SESSÃO E CRIPTOGRAFIA [OBRIGATÓRIO E SECRETO]
# Gere no cofre um valor aleatório exclusivo por instalação, com no mínimo
# 32 bytes. Este valor protege cookies de sessão e tokens; sua troca encerra
# sessões existentes. Substitua obrigatoriamente o placeholder antes do deploy.
# -----------------------------------------------------------------------------
SESSION_SECRET=replace-me

# -----------------------------------------------------------------------------
# 3. TRAVAS DE PRODUÇÃO [OBRIGATÓRIO MANTER ESTES VALORES]
# Produção recusa autenticação simulada e dados mockados do Painel WhatsApp.
# -----------------------------------------------------------------------------
AUTH_SIMULATION_ENABLED=false
LUME_TENANT_WHATSAPP_DATA_SOURCE=api

# -----------------------------------------------------------------------------
# 4. IDENTIDADE VISUAL PÚBLICA [OPCIONAL]
# Estes valores são visíveis no navegador e precisam ser passados também como
# --build-arg na imagem Docker. Não coloque API keys, licenças, senhas ou tokens
# em variáveis NEXT_PUBLIC_*.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TENANT_NAME=Empresa
NEXT_PUBLIC_TENANT_PRODUCT_NAME=Lume
