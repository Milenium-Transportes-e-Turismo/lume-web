# =============================================================================
# LUME TENANT WEB — DESENVOLVIMENTO LOCAL
# Copie para .env.local. Não versione o arquivo real nem inclua segredos aqui.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CONEXÃO COM A TENANT API [OBRIGATÓRIO]
# URL server-side da API desta mesma instalação. O navegador não usa esta URL
# diretamente; integrações externas e persistência permanecem no servidor.
# O timeout comum aceita 100–30000 ms. Os timeouts longos aceitam inteiros a
# partir de 30000 ms. Todos são validados pelos schemas de src/env.ts.
# -----------------------------------------------------------------------------
LUME_TENANT_API_URL=http://localhost:3333/api/v1
LUME_TENANT_API_TIMEOUT_MS=5000
LUME_TENANT_API_DOCUMENT_REVIEW_TIMEOUT_MS=300000
LUME_TENANT_API_WHATSAPP_IMPORT_TIMEOUT_MS=600000

# -----------------------------------------------------------------------------
# 2. SESSÃO E CRIPTOGRAFIA [OBRIGATÓRIO E SECRETO]
# Troque o valor por uma sequência aleatória exclusiva desta instalação, com
# pelo menos 32 bytes. Nunca reutilize o segredo de produção no desenvolvimento.
# -----------------------------------------------------------------------------
SESSION_SECRET=replace-with-at-least-32-random-characters

# -----------------------------------------------------------------------------
# 3. FONTES DE DADOS E SIMULAÇÃO [OPCIONAL, COM PADRÕES SEGUROS]
# AUTH_SIMULATION_ENABLED=true só é permitido em desenvolvimento explicitamente.
# LUME_TENANT_WHATSAPP_DATA_SOURCE=mock serve apenas para testes isolados.
# Em produção, ambos devem permanecer exatamente como abaixo.
# -----------------------------------------------------------------------------
AUTH_SIMULATION_ENABLED=false
# Acesso direto sem login: somente development + simulacao + fonte mock.
AUTH_LOCAL_AUTO_LOGIN=false
LUME_TENANT_WHATSAPP_DATA_SOURCE=api

# -----------------------------------------------------------------------------
# 4. IDENTIDADE VISUAL PÚBLICA [OPCIONAL]
# Variáveis NEXT_PUBLIC_* são incluídas no JavaScript enviado ao navegador e,
# em imagens Docker, precisam ser definidas durante o build: jamais armazene API
# keys, senhas, tokens ou licenças neste bloco.
# A marca, as cores e o logotipo Lume são definidos pelo design system da aplicação.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TENANT_NAME=Empresa
NEXT_PUBLIC_TENANT_PRODUCT_NAME=Lume

# -----------------------------------------------------------------------------
# 5. MAPA DE ROTEIRIZAÇÃO [OPCIONAL E PÚBLICO]
# URL do estilo MapLibre fornecida server-side à página. O valor fica visível no
# navegador e nunca deve conter segredo. O padrão usa OpenFreeMap Liberty.
# -----------------------------------------------------------------------------
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
